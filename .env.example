# HTTP process only. DDL stays in drp-payment-db. No AMQP here (Q-001).
HTTP_ADDR=:8084
PORT=8084
SERVICE_NAME=payment-service
PAYMENT_API_NETWORK=drp-dev_default
# Host process: localhost. Compose injects identity-api / reservation-api / postgres.
IDENTITY_JWKS_URL=http://localhost:8081/api/v1/auth/jwks
# Empty reservation URL = in-memory catalog (tests) and no outbox hop.
RESERVATION_API_URL=http://localhost:8083
NOTIFICATION_API_URL=http://localhost:8085
# Outbound TB6 (this API → reservation). Different from the notification hop.
PAYMENT_INTERNAL_TOKEN=change-me-tb6-payment
NOTIFICATION_INTERNAL_TOKEN=change-me-notification-hop
# Optional local walking fallback if both hops share one secret. Empty before qa.
INTERNAL_EVENT_TOKEN=
# Empty = in-memory payments. Set after Flyway on drp-payment-db (includes user_id).
DATABASE_URL=postgres://payment_app:change-me-payment@localhost:5432/drp?sslmode=disable&search_path=payment
