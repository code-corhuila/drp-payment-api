# HTTP process only. DDL stays in drp-payment-db.
HTTP_ADDR=:8084
PORT=8084
SERVICE_NAME=payment-service
IDENTITY_JWKS_URL=http://identity-api:8081/api/v1/auth/jwks
# Empty reservation URL = in-memory catalog (tests) and no outbox hop.
RESERVATION_API_URL=http://localhost:8083
NOTIFICATION_API_URL=http://localhost:8085
INTERNAL_EVENT_TOKEN=spacehub-dev-internal
# Empty = in-memory payments. Set after Flyway on drp-payment-db (includes user_id).
DATABASE_URL=postgres://payment_app:change-me-payment@localhost:5432/drp?sslmode=disable&search_path=payment
